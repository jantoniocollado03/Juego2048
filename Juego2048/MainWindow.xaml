<Window x:Class="Juego2048.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Juego2048"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Background="#FFFFFF"
        FontFamily="Segoe UI"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="PUNTUACIÓN" 
                           FontSize="11" 
                           FontWeight="Bold" 
                           Foreground="#776E65" 
                           Margin="0,0,0,2"/>
                <TextBlock x:Name="TxtScore" 
                           Text="0" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="#0B4F8A"/>
            </StackPanel>

            <Button x:Name="BtnNewGame"
                    Grid.Column="1"
                    Content="Nueva partida"
                    Background="#E87A1E"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="13"
                    Padding="14,8"
                    BorderThickness="0"
                    VerticalAlignment="Center">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <Border Grid.Row="1"
                Background="#BBADA0"
                CornerRadius="8"
                Padding="8">
            <UniformGrid x:Name="GridBoard" 
                         Rows="4" 
                         Columns="4">
                <!-- 
                     Si generas las casillas por código en el .cs, asegúrate de aplicar:
                     - Casilla vacía: Background="#CCC0B4", CornerRadius="6", Margin="4"
                     - Ficha '2': Background="#EEE4DA", Foreground="#776E65", FontSize="24", FontWeight="Bold"
                -->
            </UniformGrid>
        </Border>
    </Grid>
</Window>
